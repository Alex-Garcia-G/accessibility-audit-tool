# Copy this file to .env and fill in your values.
# Never commit .env — it contains real secrets.

# Anthropic API key — https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string
# Local dev: matches docker-compose.yml defaults
# Production: set by Railway automatically
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accessibility_audit

# GitHub OAuth app — https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Random string used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Frontend URL (used for OAuth redirect after login)
CLIENT_URL=http://localhost:5173

# Server port (optional — defaults to 3000)
PORT=3000

# Set to "production" on Railway — enables stricter env var checks
NODE_ENV=development
